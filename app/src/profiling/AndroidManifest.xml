<?xml version="1.0" encoding="utf-8"?>
<!-- Lets the Android Studio Profiler attach to a non-debuggable build (Android 10+). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>

</manifest>

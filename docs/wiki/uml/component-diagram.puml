@startuml component-diagram
' UML 2.5 component diagram · Vinilos (Wine Music) · Sprint 1
' Render: java -jar plantuml.jar -tsvg component-diagram.puml
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam ArrowColor #17140F
skinparam component {
  BackgroundColor #FFFDF8
  BorderColor #17140F
}
skinparam interface {
  BackgroundColor #FFFDF8
  BorderColor #17140F
}
skinparam node {
  BackgroundColor #F3EEE4
  BorderColor #17140F
}
top to bottom direction
skinparam nodesep 40
skinparam ranksep 30
title Vinilos – UML Component Diagram (Sprint 1)

node "Android device (API 21+)" <<device>> {
  component "Vinilos App\n<<executable>>\ncom.dev.wine.music.app" as APP {

    component "MainActivity\n<<Activity>>" as ACT
    component "Navigation\n(MainScreen, WineMusicNavHost)" as NAV
    component "Compose Screens\n(AlbumList, AlbumDetail,\nArtistList, CollectorList)" as SCREENS
    component "ViewModels\n<<HiltViewModel>>" as VMS
    component "Use Cases\n(GetAlbums, GetAlbumDetail,\nGetArtists, GetCollectors)" as UC
    component "Repositories\n(AlbumRepositoryImpl,\nArtistRepositoryImpl,\nCollectorRepositoryImpl)" as REPO
    component "Service Adapter\n<<Retrofit>>\n(AlbumApi, ArtistApi, CollectorApi)" as SA
    component "HTTP Client\n(OkHttp + kotlinx.serialization)" as HTTP
    component "Image Loader\n<<Coil>>" as COIL
    component "DI Container\n<<Hilt>>\n(ApiConfigModule, NetworkModule,\nRepositoryModule)" as DI

    interface "StateFlow<UiState<T>>\n+ event functions" as I_STATE
    interface "invoke()" as I_UC
    interface "AlbumRepository\nArtistRepository\nCollectorRepository" as I_REPO
    interface "suspend API calls" as I_API
    interface "Call.Factory" as I_HTTP
    interface "AsyncImage" as I_IMG

    ACT -right-> NAV : <<use>>
    NAV -right-> SCREENS : <<use>>

    VMS -up-() I_STATE
    SCREENS -down-( I_STATE

    UC -up-() I_UC
    VMS -down-( I_UC

    REPO -up-() I_REPO
    UC -down-( I_REPO

    SA -up-() I_API
    REPO -down-( I_API

    HTTP -up-() I_HTTP
    SA -down-( I_HTTP

    COIL -left-() I_IMG
    SCREENS -right-( I_IMG

    DI .up.> VMS : <<inject>>
    DI .up.> REPO : <<inject>>
    DI .up.> SA : <<inject>>
  }
}

node "BackVynils server" <<executionEnvironment>> {
  component "BackVynils REST API\n<<NestJS>>" as API
  database "PostgreSQL" as DB
  interface "REST / JSON (HTTP GET)" as I_REST
  API -up-() I_REST
  API --> DB : <<TypeORM>>
}

cloud "Image hosts" as IMGHOST
interface "HTTPS images" as I_IMGHOST
IMGHOST -() I_IMGHOST

HTTP -down-( I_REST
COIL -right-( I_IMGHOST
@enduml

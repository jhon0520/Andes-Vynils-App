@startuml package-diagram
' UML 2.5 package diagram · Vinilos (Wine Music) · Sprint 1
' Render: java -jar plantuml.jar -tsvg package-diagram.puml
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam ArrowColor #17140F
skinparam packageStyle folder
skinparam package {
  BackgroundColor #FFFDF8
  BorderColor #17140F
}
set separator none
title Vinilos – UML Package Diagram (Sprint 1)

package "com.dev.wine.music.app" as ROOT {
  package "app (root)\nMainActivity, WineMusicApp" as P_ROOT {
  }

  package "ui" as P_UI {
    package "ui.album.list" as P_UI_ALIST {
    }
    package "ui.album.detail" as P_UI_ADETAIL {
    }
    package "ui.artist" as P_UI_ARTIST {
    }
    package "ui.collector" as P_UI_COLLECTOR {
    }
    package "ui.navigation" as P_UI_NAV {
    }
    package "ui.common" as P_UI_COMMON {
    }
    package "ui.components" as P_UI_COMP {
    }
    package "ui.theme" as P_UI_THEME {
    }
  }

  package "domain" as P_DOMAIN {
    package "domain.usecase" as P_D_UC {
    }
    package "domain.repository" as P_D_REPO {
    }
    package "domain.model" as P_D_MODEL {
    }
  }

  package "data" as P_DATA {
    package "data.repository" as P_DA_REPO {
    }
    package "data.mapper" as P_DA_MAP {
    }
    package "data.remote" as P_DA_REMOTE {
      package "data.remote.api" as P_DA_API {
      }
      package "data.remote.dto" as P_DA_DTO {
      }
    }
  }

  package "di" as P_DI {
  }
}

package "External libraries" as EXT {
  package "androidx.compose\n(Material 3, Navigation)" as X_COMPOSE {
  }
  package "androidx.lifecycle\n(ViewModel)" as X_LIFECYCLE {
  }
  package "dagger.hilt" as X_HILT {
  }
  package "retrofit2 / okhttp3\nkotlinx.serialization" as X_NET {
  }
  package "coil" as X_COIL {
  }
}

' --- app internal dependencies (all point towards domain) ---
P_ROOT ..> P_UI_NAV : <<import>>
P_ROOT ..> P_UI_THEME : <<import>>

P_UI_NAV ..> P_UI_ALIST : <<import>>
P_UI_NAV ..> P_UI_ADETAIL : <<import>>
P_UI_NAV ..> P_UI_ARTIST : <<import>>
P_UI_NAV ..> P_UI_COLLECTOR : <<import>>

P_UI_ALIST ..> P_UI_COMMON : <<import>>
P_UI_ALIST ..> P_UI_COMP : <<import>>
P_UI_ADETAIL ..> P_UI_COMMON : <<import>>
P_UI_ARTIST ..> P_UI_COMMON : <<import>>
P_UI_COLLECTOR ..> P_UI_COMMON : <<import>>

P_UI ..> P_D_UC : <<import>>
P_UI ..> P_D_MODEL : <<import>>

P_D_UC ..> P_D_REPO : <<import>>
P_D_UC ..> P_D_MODEL : <<import>>
P_D_REPO ..> P_D_MODEL : <<import>>

P_DA_REPO ..> P_D_REPO : <<import>>\n(implements)
P_DA_REPO ..> P_DA_API : <<import>>
P_DA_REPO ..> P_DA_MAP : <<import>>
P_DA_MAP ..> P_DA_DTO : <<import>>
P_DA_MAP ..> P_D_MODEL : <<import>>
P_DA_API ..> P_DA_DTO : <<import>>

P_DI ..> P_DA_REPO : <<import>>
P_DI ..> P_DA_API : <<import>>
P_DI ..> P_D_REPO : <<import>>

' --- external dependencies ---
P_UI ..> X_COMPOSE : <<access>>
P_UI ..> X_LIFECYCLE : <<access>>
P_UI ..> X_COIL : <<access>>
P_DA_REMOTE ..> X_NET : <<access>>
P_DI ..> X_HILT : <<access>>
P_DI ..> X_NET : <<access>>
@enduml
